# Server-side base URL of @metrobet/api (used by Server Components only).
API_URL=http://localhost:4000/api

# Public origin of the api for browser real-time connections (Socket.IO).
NEXT_PUBLIC_API_WS_URL=http://localhost:4000

# Public base URL of uploaded media (allowed in next/image).
MEDIA_PUBLIC_URL=http://localhost:4000/media
# Local dev only: media is served from localhost, which Next blocks from optimization by default.
IMAGES_ALLOW_LOCAL_IP=true

# Shared with the api (WEB_REVALIDATE_SECRET) so it can refresh cached content.
REVALIDATE_SECRET=change-me-to-a-random-64-char-hex-string-0000000000000000
