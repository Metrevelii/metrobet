NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
DATABASE_URL=postgres://metrobet:metrobet@localhost:5432/metrobet
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

SPORTSBOOK_FEED=simulated
# mock | public-demos (dev only: real Pragmatic Play + BGaming slots via their free public demos)
CASINO_AGGREGATOR=mock
AUTH_RATE_LIMIT=10
TRUST_PROXY=loopback

# Dev seed: creates admin@metrobet.local with this password (never in production).
SEED_ADMIN_PASSWORD=change-me


MEDIA_DIR=uploads
MEDIA_PUBLIC_URL=http://localhost:4000/media

# Player site cache revalidation (must match REVALIDATE_SECRET in apps/web/.env.local)
WEB_URL=http://localhost:3000
WEB_REVALIDATE_SECRET=change-me-to-a-random-64-char-hex-string-0000000000000000
