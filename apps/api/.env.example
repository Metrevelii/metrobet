NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
DATABASE_URL=postgres://metrobet:metrobet@localhost:5432/metrobet
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Temporary shared key for /api/admin/* (backoffice). Generate: openssl rand -hex 32
ADMIN_API_KEY=change-me-to-a-random-64-char-hex-string-0000000000000000

MEDIA_DIR=uploads
MEDIA_PUBLIC_URL=http://localhost:4000/media

# Player site cache revalidation (must match REVALIDATE_SECRET in apps/web/.env.local)
WEB_URL=http://localhost:3000
WEB_REVALIDATE_SECRET=change-me-to-a-random-64-char-hex-string-0000000000000000
