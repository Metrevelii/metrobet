# Base URL of @metrobet/api (server-side only).
API_URL=http://localhost:4000/api

# Must equal ADMIN_API_KEY in apps/api/.env. Server-only: never prefix with NEXT_PUBLIC_.
ADMIN_API_KEY=change-me-to-a-random-64-char-hex-string-0000000000000000

# Player site origin, used to preview artwork stored as site-relative paths (e.g. /promotions/x.svg).
NEXT_PUBLIC_WEB_URL=http://localhost:3000
